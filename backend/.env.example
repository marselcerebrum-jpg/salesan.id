# =============================================================================
# salesan.id backend — copy to .env and fill in.
# =============================================================================

APP_ENV=development
PORT=8080
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
#
# Use the DIRECT connection string, or the session-mode pooler on port 5432:
#   Supabase Dashboard → Project Settings → Database → Connection string → URI
#
# If you must use the transaction-mode pooler (port 6543), append
#   ?default_query_exec_mode=simple_protocol
# because PgBouncer in transaction mode cannot hold prepared statements.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Where whatsmeow keeps its own device/session tables (whatsmeow_*).
# Leave empty to reuse DATABASE_URL. This is the ONLY place WhatsApp
# credentials live; they are never sent to the browser.
WHATSMEOW_DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase Auth
#
# Set SUPABASE_URL and the backend derives the JWKS endpoint automatically —
# that covers projects using the current asymmetric signing keys.
# For projects still on the legacy shared secret, set SUPABASE_JWT_SECRET
# (Dashboard → Project Settings → API → JWT Settings → JWT Secret).
# Setting both is fine: the algorithm in each token picks the right one.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# -----------------------------------------------------------------------------
# Media & dokumen (Supabase Storage)
#
# Foto, video, audio dan dokumen tidak pernah masuk ke database — yang masuk
# hanya metadata dan letaknya. Berkasnya sendiri disimpan di salah satu dari
# dua tempat:
#
#   1. Bucket PRIVAT Supabase Storage, bila SUPABASE_SERVICE_ROLE_KEY diisi.
#      Ini yang dianjurkan: berkas hidup di luar mesin ini.
#      Kuncinya: Dashboard → Project Settings → API keys → service_role.
#      Kunci ini melewati RLS, jadi HANYA boleh di sisi server. Jangan pernah
#      menaruhnya di web/.env.local atau variabel berawalan NEXT_PUBLIC_.
#      Bucket-nya dibuat otomatis saat backend pertama kali start.
#
#   2. Folder di mesin ini, bila kunci itu kosong. Media tetap berjalan penuh.
#      Foldernya tidak disajikan sebagai web statis; berkas hanya keluar lewat
#      tautan bertanda tangan yang kedaluwarsa — sama seperti Supabase.
#      Yang tidak didapat: ketahanan di luar disk mesin ini.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=wa-media

# Umur signed URL. Cukup pendek agar tautan yang bocor cepat mati, cukup
# panjang agar sebuah video selesai diputar.
MEDIA_URL_TTL=1h

# --- hanya dipakai bila menyimpan di mesin ini -------------------------------
# Folder penyimpanan (relatif terhadap folder backend). Jangan dijadikan
# folder publik server web mana pun.
MEDIA_DIR=.media

# Kunci penanda tangan tautan media. Dibiarkan kosong berarti diturunkan dari
# DATABASE_URL, sehingga tautan tetap sah setelah backend restart tanpa perlu
# setelan tambahan. Isi sendiri bila ingin memutar kuncinya.
MEDIA_SIGNING_SECRET=

# Alamat backend ini dari sisi browser. Tautan media lokal bersifat absolut,
# jadi nilai ini harus benar saat deploy (mis. https://api.salesan.id).
PUBLIC_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
# Comma-separated. Also gates the WebSocket handshake's Origin check.
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# WhatsApp behaviour
# -----------------------------------------------------------------------------
QR_TIMEOUT=3m
RECONNECT_BASE_DELAY=3s
RECONNECT_MAX_DELAY=5m

# Keeps read state two-way: opening a chat here marks it read on the phone,
# just as reading it on the phone clears the badge here. Set false to stay
# invisible to the customer ("blue ticks" off) — at the cost of the two sides
# drifting apart.
WA_AUTO_MARK_READ=true

# -----------------------------------------------------------------------------
# Agar tidak dikira bot
#
# WhatsApp mengawasi akun yang membalas seketika, tidak pernah menampilkan
# indikator mengetik, membiarkan pesan masuk tak terbaca, dan mengirim beruntun
# tanpa jeda. Akun seperti itu dibatasi lalu diblokir — dan yang kena adalah
# nomor bisnis sungguhan, bukan aplikasinya.
#
# Dinyalakan, setiap pesan keluar melewati urutan yang sama seperti orang
# sungguhan: baca chatnya → tampil online → mengetik sebentar → berhenti →
# kirim. Ditambah jeda minimum antar pesan.
#
# Matikan hanya bila kamu punya alasan kuat; akun jadi jauh lebih mudah kena.
# -----------------------------------------------------------------------------
WA_HUMANIZE=true

# Menandai akun "online" saat mengirim. WhatsApp hanya meneruskan indikator
# mengetik dari perangkat yang dianggap online, jadi tanpa ini tulisan
# "sedang mengetik…" tidak akan pernah terlihat lawan bicara. Konsekuensinya
# kontak bisa melihat akun sebagai online — sama seperti orang memegang HP.
WA_PRESENCE_ONLINE=true

# Lama indikator mengetik: minimal, maksimal, dan berapa huruf per detik yang
# dipakai untuk menyesuaikannya dengan panjang pesan. Semuanya diberi variasi
# acak ±20%, karena balasan yang selalu tepat 2,0 detik justru mencurigakan.
WA_TYPING_MIN=900ms
WA_TYPING_MAX=4s
WA_TYPING_CPS=25

# Jarak minimum antara dua pesan dari satu akun. Ini yang membuat "teruskan ke
# 20 chat" keluar sebagai rentetan pesan, bukan satu ledakan.
WA_SEND_MIN_GAP=1500ms

# =============================================================================
# Dashboard Operasional & Performa
# =============================================================================
# Semua perhitungan tanggal memakai zona waktu Asia/Jakarta (WIB), tidak
# mengikuti jam server. Ini tidak bisa dikonfigurasi: laporan satu tim harus
# menyebut "hari ini" yang sama untuk semua orang.

# Janji waktu balas untuk chat pribadi. Dibalas dalam batas ini, siklus SLA
# dihitung tercapai. Default 15 menit.
SLA_TARGET_SECONDS=900

# Menghitung SLA hanya atas waktu yang jatuh di dalam jadwal kerja admin.
#
# Default mati. Nyalakan setelah jadwal benar-benar diisi di halaman
# Performa > Tim & jadwal; sebelum itu setiap siklus tetap jatuh ke jam dinding
# dan menyalakannya hanya mengubah arti angkanya tanpa mengubah hasilnya.
SLA_BUSINESS_HOURS=false

# Berapa lama sebuah chat harus diam sebelum pesan admin ke chat itu dihitung
# sebagai follow-up, bukan lanjutan percakapan. Default 6 jam.
FOLLOWUP_GAP=6h

# Selang penyapuan rekonsiliasi: memperbaiki baris laporan yang tertinggal
# karena event hilang, proses restart, atau reconnect WhatsApp. Perhitungan
# bersifat idempoten, jadi menyapu lebih sering aman - hanya lebih berisik.
METRICS_RECONCILE_INTERVAL=15m


# =============================================================================
# Broadcast & WA Story
# =============================================================================
# Antreannya hidup di basis data, bukan di proses ini. Nilai-nilai di bawah
# mengatur seberapa sering scheduler bertanya dan berapa lama sebuah klaim
# dipegang - bukan seberapa cepat pesan dikirim, yang ditentukan profil jeda
# yang dipilih pada tiap campaign.

# Jeda scheduler menanyakan pekerjaan yang jatuh tempo. Pendek, karena campaign
# yang dijalankan dari antarmuka sebaiknya mulai segera; kuerinya satu lookup
# berindeks.
CAMPAIGN_POLL_INTERVAL=5s

# Lama sebuah klaim berlaku sebelum worker lain boleh mengambil alih. Harus
# lebih panjang dari satu pengiriman plus jedanya: terlalu pendek membuat dua
# worker bertumpuk, terlalu panjang membuat backend yang mati menghalangi
# pemulihannya sendiri.
CAMPAIGN_LEASE=10m

# Berapa campaign yang dijalankan bersamaan oleh proses ini. Perangkat di dalam
# satu campaign tetap mengirim paralel, apa pun nilainya.
CAMPAIGN_CONCURRENCY=4

# Batas unduhan media campaign. Media dimasukkan sebagai URL; berkasnya diunduh
# sementara saat mengirim lalu dihapus, dan tidak pernah disimpan di basis data.
CAMPAIGN_MEDIA_MAX_BYTES=67108864
CAMPAIGN_MEDIA_TIMEOUT=2m
# Kosongkan untuk memakai direktori sementara sistem.
CAMPAIGN_TEMP_DIR=

# -----------------------------------------------------------------------------
# Draft GPT (opsional)
# -----------------------------------------------------------------------------
# Tanpa kunci, mode "Buat dengan GPT" melaporkan dirinya belum dikonfigurasi dan
# seluruh mode composer lain tetap bekerja. GPT hanya menghasilkan draft:
# pengguna tetap harus meninjau dan menekan kirim sendiri.
#
# Kunci ini tidak pernah masuk ke basis data, log, atau jawaban API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini