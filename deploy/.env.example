# =============================================================================
# deploy/.env — the handful of values that are specific to this server.
# Copy to deploy/.env and fill in. Everything else the backend needs stays in
# backend/.env (copy backend/.env.example there), exactly as on a laptop.
# =============================================================================

# Hostname people open in the browser, and the hostname the API answers on.
# Both must already resolve (DNS A record) to this VPS before the first start,
# because Caddy requests the HTTPS certificates on demand.
APP_DOMAIN=app.contoh.id
API_DOMAIN=api.contoh.id

# From the Supabase dashboard: Project Settings → API. The anon key is public
# by design (it is in every browser); the service_role key is NOT and belongs
# only in backend/.env.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
